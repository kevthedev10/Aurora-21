{
  "name": "project21-control-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:build": "node scripts/build-card-catalog.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.selfhost.json",
    "build:selfhost": "esbuild src/self-hosted.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --outfile=dist-selfhost/server.mjs",
    "start:selfhost": "node dist-selfhost/server.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "db:local": "wrangler d1 migrations apply project21-control --local",
    "db:remote": "wrangler d1 migrations apply project21-control --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
