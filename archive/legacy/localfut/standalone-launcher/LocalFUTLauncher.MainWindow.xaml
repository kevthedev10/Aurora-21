<Window x:Class="Project21Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project 21 Launcher"
        Width="1120" Height="700" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource PageBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#323238" BorderThickness="1" Background="{StaticResource PageBackground}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#0D0D10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Border Width="24" Height="24" Background="{StaticResource Accent}" CornerRadius="6">
            <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="PROJECT 21" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="FIFA 21 LAUNCHER" Foreground="#5F5F66" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButtonStyle}" Content="—" FontSize="13" Click="MinimizeButton_Click" ToolTip="Minimize"/>
          <Button Style="{StaticResource CloseWindowButtonStyle}" Content="×" FontSize="17" Click="CloseButton_Click" ToolTip="Close"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D0D10" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,1,1,0">
          <Grid Margin="18,28,18,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="MENU" Margin="13,0,0,12" Foreground="#57575E" FontSize="8" FontWeight="Bold"/>
              <Button x:Name="OverviewNavButton" Style="{StaticResource ActiveNavButtonStyle}" Click="OverviewNavButton_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="●" Width="25" Foreground="{StaticResource Accent}" FontSize="10"/><TextBlock Text="Play"/></StackPanel>
              </Button>
              <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsNavButton_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="25" FontSize="14"/><TextBlock Text="Settings"/></StackPanel>
              </Button>
            </StackPanel>
            <Border Grid.Row="2" Padding="12" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="10">
              <StackPanel><TextBlock Text="PLAYER LAUNCHER" Foreground="#929299" FontSize="10"/><TextBlock Text="Project 21" Margin="0,4,0,0" Foreground="#55555B" FontSize="9"/></StackPanel>
            </Border>
          </Grid>
        </Border>
        <ScrollViewer x:Name="OverviewView" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="36,32,36,34">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="330"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="WELCOME" Foreground="#67676F" FontSize="8" FontWeight="Bold"/><TextBlock Text="Ready for match day?" Margin="0,6,0,0" FontSize="26" FontWeight="SemiBold"/></StackPanel>
            <Border Grid.Row="2" CornerRadius="20" BorderBrush="#34343A" BorderThickness="1" ClipToBounds="True">
              <Grid Background="#151519">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                  <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill" Opacity="0.84"/>
                  <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF151519" Offset="0"/><GradientStop Color="#B3151519" Offset="0.28"/><GradientStop Color="#00151519" Offset="0.82"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                </Grid>
                <StackPanel Grid.ColumnSpan="2" Margin="44,35,0,30" VerticalAlignment="Center" HorizontalAlignment="Left" Width="500">
                  <Border Padding="10,6" Margin="0,0,0,22" HorizontalAlignment="Left" Background="#241633" BorderBrush="#6A0DAD" BorderThickness="1" CornerRadius="12">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0"/><TextBlock Text="PRIVATE ONLINE SERVER" Foreground="#D8B8F0" FontSize="7" FontWeight="Bold"/></StackPanel>
                  </Border>
                  <TextBlock Text="FIFA 21  •  ULTIMATE TEAM" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                  <TextBlock Text="BUILD YOUR CLUB.&#x0a;PLAY TOGETHER." Margin="0,9,0,0" FontFamily="Arial Black" FontSize="39" FontWeight="Black" LineHeight="40"/>
                  <TextBlock Text="Discord access and the private connection are checked automatically." Margin="0,14,0,0" Foreground="#A4A4AA" FontSize="11"/>
                  <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="LaunchButton" Style="{StaticResource ActionButtonStyle}" Width="166" Content="▶   LAUNCH FIFA 21" Click="LaunchButton_Click" IsEnabled="False"/>
                    <Button x:Name="StopButton" Style="{StaticResource SecondaryActionButtonStyle}" Width="105" Margin="9,0,0,0" Content="STOP" Click="StopButton_Click"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Padding="22" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="15">
                <StackPanel>
                  <TextBlock Text="CONNECTION" Foreground="#626269" FontSize="7" FontWeight="Bold"/>
                  <TextBlock x:Name="ConnectionStatusText" Text="Checking connection…" Margin="0,7,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="WorkflowStatusText" Text="Ready" Margin="0,7,0,0" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="SetupWireGuardButton" Style="{StaticResource SecondaryActionButtonStyle}" Width="150" Content="CONNECT DISCORD" Click="SetupWireGuardButton_Click"/>
                    <Button x:Name="CheckWireGuardButton" Style="{StaticResource SecondaryActionButtonStyle}" Width="145" Margin="9,0,0,0" Content="CHECK AGAIN" Click="CheckWireGuardButton_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="22" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="15">
                <StackPanel><TextBlock Text="GAME" Foreground="#626269" FontSize="7" FontWeight="Bold"/><TextBlock x:Name="GameStatusText" Text="Not running" Margin="0,7,0,0" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="PythonStatusText" Text="Checking the required Python version…" Margin="0,7,0,0" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap"/><TextBlock Text="Choose FIFA21.exe in Settings if this is your first launch." Margin="0,7,0,0" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap"/></StackPanel>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsView" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="36,32,36,34" MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="CONFIGURATION" Foreground="{StaticResource Accent}" FontSize="8" FontWeight="Bold"/><TextBlock Text="Launcher settings" Margin="0,7,0,0" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Choose where FIFA 21 is installed on this PC." Margin="0,9,0,0" Foreground="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
            <Border Grid.Row="2" Padding="28" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="16">
              <StackPanel>
                <TextBlock Text="GAME LOCATION" Foreground="#77777F" FontSize="8" FontWeight="Bold"/><TextBlock Text="FIFA21.exe" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Select the main FIFA 21 executable, not the configuration launcher." Margin="0,5,0,12" Foreground="#77777F" FontSize="9"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePathTextBox" Style="{StaticResource SettingsTextBoxStyle}"/><Button Grid.Column="2" Style="{StaticResource SettingsButtonStyle}" Content="BROWSE…" Click="BrowseGameButton_Click"/></Grid>
                <Grid Margin="0,25,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SettingsStatusText" Text="The game location is saved for this Windows user." Foreground="#707077" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Width="150" Height="46" Content="SAVE" Foreground="{StaticResource AccentDark}" Background="{StaticResource Accent}" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="SaveSettingsButton_Click"/></Grid>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
