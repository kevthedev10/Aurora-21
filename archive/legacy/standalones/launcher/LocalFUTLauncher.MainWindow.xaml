<Window x:Class="Project21Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora 21 (Alpha v1)"
        Width="1280" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Topmost="True"
        Background="{StaticResource PageBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI Variable Text, Segoe UI" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
  </WindowChrome.WindowChrome>

  <Border x:Name="LauncherShell"
          BorderBrush="#241F2933" BorderThickness="1"
          Background="{StaticResource PageBackground}" CornerRadius="2"
          RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="LauncherShellScale" ScaleX="1" ScaleY="1" />
        <TranslateTransform x:Name="LauncherShellTranslate" X="0" Y="0" />
      </TransformGroup>
    </Border.RenderTransform>
    <Grid ClipToBounds="True">
      <!-- Immersive full-window FIFA background -->
      <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill" Opacity="0.42">
        <Image.Effect>
          <BlurEffect Radius="30" />
        </Image.Effect>
        <Image.RenderTransform>
          <ScaleTransform ScaleX="1.10" ScaleY="1.10" />
        </Image.RenderTransform>
      </Image>
      <Rectangle Fill="#C10A0D12" />
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.76,0.14" GradientOrigin="0.76,0.14" RadiusX="0.66" RadiusY="0.74">
            <GradientStop Color="#268FC7E6" Offset="0" />
            <GradientStop Color="#0F7A80C4" Offset="0.48" />
            <GradientStop Color="#007B76FF" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#18000000" Offset="0" />
            <GradientStop Color="#3C000000" Offset="0.72" />
            <GradientStop Color="#82000000" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Floating glass title bar -->
        <Grid Grid.Row="0" Margin="16,10,12,0">
          <Border Background="#C0131921" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="21">
            <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.15" Color="#000000" /></Border.Effect>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="assets/Aurora21-logo.png" Width="30" Height="30" Margin="0,0,9,0" Stretch="UniformToFill" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="AURORA 21" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="FIFA 21 REVIVAL" Margin="0,1,0,0" Foreground="#93A2B4" FontSize="7.5" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="1" HorizontalAlignment="Center" Padding="10,5" CornerRadius="15" Background="#AE171E27" BorderBrush="#24FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Text="PRIVATE NETWORK" Foreground="#D6DEE8" FontSize="7" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Minimal music controls: no track title is shown. -->
                <Border x:Name="MusicPlayerBorder"
                        Height="34" Margin="0,0,8,0" Padding="5,2,9,2"
                        CornerRadius="17" Background="#AE171E27"
                        BorderBrush="#24FFFFFF" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MusicPlayPauseButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Width="28" Height="28" Padding="0"
                            Content="▶" FontSize="10"
                            Click="MusicPlayPauseButton_Click"
                            ToolTip="Play or pause music" />
                    <Button x:Name="MusicSkipButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Width="28" Height="28" Padding="0"
                            Content="⏭" FontFamily="Segoe UI Symbol" FontSize="10"
                            Click="MusicSkipButton_Click"
                            ToolTip="Skip track" />
                    <Button x:Name="MusicMuteButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Width="28" Height="28" Padding="0"
                            Content="🔊" FontFamily="Segoe UI Emoji" FontSize="11"
                            Click="MusicMuteButton_Click"
                            ToolTip="Mute or unmute music" />
                    <Slider x:Name="MusicVolumeSlider"
                            Style="{StaticResource MusicSliderStyle}"
                            Width="82" Margin="4,0,0,0"
                            Minimum="0" Maximum="1" Value="0.12"
                            SmallChange="0.05" LargeChange="0.10"
                            ValueChanged="MusicVolumeSlider_ValueChanged"
                            ToolTip="Music volume" />
                  </StackPanel>
                </Border>
                <Button Style="{StaticResource WindowButtonStyle}" Content="—" FontSize="13" Click="MinimizeButton_Click" ToolTip="Minimize" />
                <Button Style="{StaticResource CloseWindowButtonStyle}" Content="×" FontSize="17" Click="CloseButton_Click" ToolTip="Close" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="16,12,16,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Floating glass navigation island -->
          <Border Grid.Column="0" Background="#C3131A22" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="30" Padding="9,14">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.16" Color="#000000" /></Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel HorizontalAlignment="Center">
                <Button x:Name="OverviewNavButton" Style="{StaticResource ActiveNavButtonStyle}" Click="OverviewNavButton_Click" ToolTip="Play">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="▶" Foreground="{StaticResource Accent}" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="PLAY" Margin="0,4,0,0" FontSize="6.5" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="ClubNavButton" Style="{StaticResource NavButtonStyle}" Click="ClubNavButton_Click" ToolTip="Club">
                  <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="19" Height="19" HorizontalAlignment="Center">
                      <Canvas Width="20" Height="20">
                        <Path Data="M10,1.5 L17,4.2 L16.2,11.2 C15.7,15 13.2,17.5 10,19 C6.8,17.5 4.3,15 3.8,11.2 L3,4.2 Z"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.45" Fill="#241A3340" StrokeLineJoin="Round" />
                        <Path Data="M7,9.8 L9.1,12 L13.4,7.6" Stroke="{StaticResource Accent}" StrokeThickness="1.55"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="CLUB" Margin="0,4,0,0" FontSize="6.2" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="DailyDropNavButton" Style="{StaticResource NavButtonStyle}" Click="DailyDropNavButton_Click" ToolTip="Daily Drop">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✦" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="DROP" Margin="0,4,0,0" FontSize="6.2" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsNavButton_Click" ToolTip="Settings">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚙" Foreground="{StaticResource Accent}" FontSize="17" HorizontalAlignment="Center" />
                    <TextBlock Text="SET" Margin="0,4,0,0" FontSize="6.5" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="ConnectionNavButton" Style="{StaticResource NavButtonStyle}" Click="ConnectionNavButton_Click" ToolTip="Connection">
                  <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="19" Height="17" HorizontalAlignment="Center">
                      <Canvas Width="20" Height="18">
                        <Path Data="M2.5,2.5 L17.5,2.5 L17.5,12.5 L2.5,12.5 Z"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.45" StrokeLineJoin="Round" />
                        <Path Data="M7,16 L13,16 M10,12.5 L10,16"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="4.3" Canvas.Top="4.5" Width="2.2" Height="2.2" Fill="{StaticResource Accent}" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="CONN" Margin="0,4,0,0" FontSize="6.2" FontWeight="Bold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="15" Background="#89182029" BorderBrush="#58CA70FF" BorderThickness="1">
                  <Image Source="assets/Aurora21-logo.png" Margin="3" Stretch="Uniform" />
                </Border>
                <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,9,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- HOME -->
          <ScrollViewer x:Name="OverviewView" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,4,8,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="446" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="FIFA 21" Foreground="#C6EEFF" FontSize="8" FontWeight="Bold" />
                  <TextBlock Text="Welcome back." Margin="0,3,0,0" FontSize="25" FontWeight="Medium" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <TextBlock Text="AURORA 21 • ALPHA V1" Foreground="#8490A0" FontSize="7.5" FontWeight="Bold" />
                  <Ellipse Width="3" Height="3" Fill="#8390A0" Margin="8,0" VerticalAlignment="Center" />
                  <TextBlock Text="REVIVAL NETWORK" Foreground="#8490A0" FontSize="7.5" FontWeight="Bold" />
                </StackPanel>
              </Grid>

              <!-- Clean immersive artwork stage: cropped in XAML so the source poster's white/black edge panels never show. -->
              <Border Grid.Row="2" CornerRadius="0" Background="#FF0A0F16" ClipToBounds="True">
                <Grid>
                  <!-- Fallback artwork is shown only when no playable video exists in the sources folder. -->
                  <Border x:Name="HeroVideoFallback" CornerRadius="0">
                    <Border.Background>
                      <ImageBrush ImageSource="pack://application:,,,/launcherimage.webp"
                                  ViewboxUnits="RelativeToBoundingBox"
                                  Viewbox="0.20,0.14,0.62,0.165"
                                  Stretch="Fill" />
                    </Border.Background>
                  </Border>

                  <!-- Video is loaded at runtime from sources\background.mp4 (or the first supported video found). -->
                  <MediaElement x:Name="HeroVideo"
                                Visibility="Collapsed"
                                Stretch="UniformToFill"
                                LoadedBehavior="Manual"
                                UnloadedBehavior="Manual"
                                IsMuted="True" Volume="0"
                                ScrubbingEnabled="True"
                                IsHitTestVisible="False"
                                MediaOpened="HeroVideo_MediaOpened"
                                MediaEnded="HeroVideo_MediaEnded"
                                MediaFailed="HeroVideo_MediaFailed" />

                  <!-- Dark readable treatment over the cropped artwork. -->
                  <Rectangle Fill="#1A060A0F" />
                  <Rectangle>
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#F0070A0F" Offset="0" />
                        <GradientStop Color="#D70A0E14" Offset="0.34" />
                        <GradientStop Color="#6B0B0F15" Offset="0.67" />
                        <GradientStop Color="#180B0F15" Offset="1" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Rectangle>
                    <Rectangle.Fill>
                      <RadialGradientBrush Center="0.74,0.14" GradientOrigin="0.74,0.14" RadiusX="0.58" RadiusY="0.68">
                        <GradientStop Color="#2CA7E5FF" Offset="0" />
                        <GradientStop Color="#0CA7E5FF" Offset="0.45" />
                        <GradientStop Color="#00A7E5FF" Offset="1" />
                      </RadialGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>

                  <Grid Margin="38,32,30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Border HorizontalAlignment="Left" Padding="12,7" CornerRadius="15" Background="#B91A232C" BorderBrush="#30FFFFFF" BorderThickness="1">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="AURORA 21 ONLINE • ALPHA V1" Foreground="#F5FAFF" FontSize="7" FontWeight="Bold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Width="520" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Text="FIFA 21  •  ULTIMATE TEAM" Foreground="#C7EEFF" FontSize="9" FontWeight="Bold" />
                      <TextBlock Text="FOOTBALL,&#x0a;REVIVED." Margin="0,8,0,0" FontFamily="Arial Black" FontSize="48" FontWeight="Black" LineHeight="47" />
                      <TextBlock Text="Your FIFA 21 club is back. Aurora 21 handles access, connection and runtime setup so you can get straight into the game."
                                 Margin="0,13,0,0" Width="450" Foreground="#C0CAD6" FontSize="10.5" LineHeight="17" TextWrapping="Wrap" HorizontalAlignment="Left" />
                      <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="LaunchButton" Style="{StaticResource ActionButtonStyle}" Width="194" Content="▶   PLAY FIFA 21" Click="LaunchButton_Click" IsEnabled="False" />
                        <Button x:Name="StopButton" Style="{StaticResource SecondaryActionButtonStyle}" Width="96" Margin="10,0,0,0" Content="STOP" Click="StopButton_Click" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                      <Border Padding="12,8" CornerRadius="15" Background="#B91A232C" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse x:Name="ConnectionStatusDot" Width="7" Height="7" Fill="{StaticResource MutedDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="CONNECTION" Foreground="#9EABB8" FontSize="6.5" FontWeight="Bold" VerticalAlignment="Center" />
                          <TextBlock x:Name="HeroConnectionStatusText" Text="Checking…" Margin="8,0,0,0" Foreground="#F4F8FC" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border Padding="12,8" Margin="8,0,0,0" CornerRadius="15" Background="#B91A232C" BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse x:Name="GameStatusDot" Width="7" Height="7" Fill="{StaticResource MutedDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="GAME" Foreground="#9EABB8" FontSize="6.5" FontWeight="Bold" VerticalAlignment="Center" />
                          <TextBlock x:Name="HeroGameStatusText" Text="Not running" Margin="8,0,0,0" Foreground="#F4F8FC" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- A single crisp inner edge replaces the old glowing/double border. -->
                  <Border CornerRadius="0" BorderBrush="#20FFFFFF" BorderThickness="1" Background="Transparent" IsHitTestVisible="False" />
                </Grid>
              </Border>

              <!-- Glass utility cards -->
              <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.16*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.84*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="21">
                  <Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="36" Height="36" CornerRadius="15" Background="#7F1A222B" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <TextBlock Text="↗" Foreground="#D7F4FF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SECURE CONNECTION" Foreground="#9EA9B5" FontSize="7" FontWeight="Bold" />
                            <TextBlock x:Name="ConnectionStatusText" Text="Checking connection…" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="WorkflowStatusText" Text="Ready" Margin="0,12,0,0" Foreground="{StaticResource SecondaryText}" FontSize="9" LineHeight="15" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button x:Name="SetupWireGuardButton" Style="{StaticResource SecondaryActionButtonStyle}" Height="42" Width="136" Content="CONNECT DISCORD" FontSize="8.5" Click="SetupWireGuardButton_Click" />
                        <Button x:Name="CheckWireGuardButton" Style="{StaticResource SecondaryActionButtonStyle}" Height="42" Width="112" Margin="8,0,0,0" Content="CHECK AGAIN" FontSize="8.5" Click="CheckWireGuardButton_Click" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="21">
                  <Grid>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="15" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                          <TextBlock Text="▶" Foreground="#D7F4FF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="GAME RUNTIME" Foreground="#9EA9B5" FontSize="7" FontWeight="Bold" />
                          <TextBlock x:Name="GameStatusText" Text="Not running" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock x:Name="PythonStatusText" Text="Checking the required Python version…" Margin="0,12,0,0" Foreground="{StaticResource SecondaryText}" FontSize="9" LineHeight="15" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </ScrollViewer>

          <!-- CLUB -->
          <ScrollViewer x:Name="ClubView" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,4,8,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="ULTIMATE TEAM" Foreground="#BFEAFF" FontSize="8" FontWeight="Bold" />
                  <TextBlock Text="My club" Margin="0,3,0,0" FontSize="25" FontWeight="Medium" />
                  <TextBlock Text="View your club record and update the identity shown in FIFA 21." Margin="0,6,0,0"
                             Foreground="{StaticResource SecondaryText}" FontSize="10" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Bottom" Padding="11,6" CornerRadius="16"
                        Background="#75182029" BorderBrush="#18FFFFFF" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="YOUR ONLINE CLUB" Foreground="#CCD7E2" FontSize="7" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.48*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="22" MinHeight="475">
                  <StackPanel>
                    <Border Width="62" Height="68" CornerRadius="24" HorizontalAlignment="Left"
                            Background="#5119232D" BorderBrush="#34FFFFFF" BorderThickness="1">
                      <Viewbox Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="20" Height="20">
                          <Path Data="M10,1.5 L17,4.2 L16.2,11.2 C15.7,15 13.2,17.5 10,19 C6.8,17.5 4.3,15 3.8,11.2 L3,4.2 Z"
                                Stroke="#D7F4FF" StrokeThickness="1.2" Fill="#261A3340" StrokeLineJoin="Round" />
                          <Path Data="M7,9.8 L9.1,12 L13.4,7.6" Stroke="{StaticResource Accent}" StrokeThickness="1.4"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="CLUB IDENTITY" Margin="0,20,0,0" Foreground="#9EA9B5" FontSize="7" FontWeight="Bold" />
                    <TextBlock Text="Name and abbreviation" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" />

                    <TextBlock Text="Club name" Margin="0,24,0,6" Foreground="#AEB9C5" FontSize="8" FontWeight="SemiBold" />
                    <TextBox x:Name="ClubNameTextBox" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="32" />
                    <TextBlock Text="Abbreviation" Margin="0,15,0,6" Foreground="#AEB9C5" FontSize="8" FontWeight="SemiBold" />
                    <TextBox x:Name="ClubAbbrTextBox" Style="{StaticResource SettingsTextBoxStyle}" MaxLength="3" CharacterCasing="Upper" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                      <Button x:Name="SaveClubButton" Style="{StaticResource SettingsButtonStyle}" Width="138" Height="42"
                              Content="SAVE NAME" Click="SaveClubButton_Click" />
                      <Button x:Name="RefreshClubButton" Style="{StaticResource SettingsButtonStyle}" Width="104" Height="42" Margin="9,0,0,0"
                              Content="REFRESH" Click="RefreshClubButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ClubStatusText" Text="Connect Discord, then refresh your club." Margin="0,14,0,0"
                               Foreground="{StaticResource SecondaryText}" FontSize="9" LineHeight="15" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="22" MinHeight="475">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CLUB OVERVIEW" Foreground="#9EA9B5" FontSize="7" FontWeight="Bold" />
                        <TextBlock Text="Balance and form" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" />
                      </StackPanel>
                      <Image Grid.Column="1" Source="assets/Aurora21-logo.png" Width="72" Height="72" Margin="16,0,0,0" Stretch="UniformToFill" />
                    </Grid>

                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" CornerRadius="20" Background="#4B10161D" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20,18">
                        <StackPanel>
                          <TextBlock Text="COIN BALANCE" Foreground="#9EA9B5" FontSize="8" FontWeight="Bold" />
                          <TextBlock x:Name="CoinBalanceText" Text="—" Margin="0,7,0,0" Foreground="#FFD66B" FontSize="30" FontWeight="Bold" />
                          <TextBlock Text="FUT coins" Margin="0,2,0,0" Foreground="#8D9BA8" FontSize="8" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="20" Background="#4B10161D" BorderBrush="#35CA70FF" BorderThickness="1" Padding="20,18">
                        <StackPanel>
                          <TextBlock Text="FIFA POINTS" Foreground="#B998CB" FontSize="8" FontWeight="Bold" />
                          <TextBlock x:Name="ClubFifaPointsText" Text="—" Margin="0,7,0,0" Foreground="#D98CFF" FontSize="30" FontWeight="Bold" />
                          <TextBlock Text="Available points" Margin="0,2,0,0" Foreground="#8D9BA8" FontSize="8" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" CornerRadius="20" Background="#4B10161D" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="18">
                        <StackPanel>
                          <TextBlock Text="W–D–L RECORD" Foreground="#9EA9B5" FontSize="8" FontWeight="Bold" />
                          <TextBlock x:Name="RecordText" Text="0 – 0 – 0" Margin="0,9,0,0" Foreground="#ECF4FA" FontSize="22" FontWeight="Bold" />
                          <TextBlock Text="Wins  •  Draws  •  Losses" Margin="0,5,0,0" Foreground="#8D9BA8" FontSize="8" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="20" Background="#4B10161D" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="18">
                        <StackPanel>
                          <TextBlock Text="CURRENT STREAK" Foreground="#9EA9B5" FontSize="8" FontWeight="Bold" />
                          <TextBlock x:Name="StreakText" Text="—" Margin="0,9,0,0" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                          <TextBlock Text="Latest recorded form" Margin="0,5,0,0" Foreground="#8D9BA8" FontSize="8" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </ScrollViewer>

          <!-- DAILY DROP -->
          <ScrollViewer x:Name="DailyDropView" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,4,8,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="AURORA VAULT" Foreground="#D8B8FF" FontSize="8" FontWeight="Bold" />
                  <TextBlock Text="Daily Case" Margin="0,3,0,0" FontSize="25" FontWeight="Medium" />
                  <TextBlock Text="Unlock one sealed reward case each day. Resets at 00:00 UTC."
                             Margin="0,6,0,0" Foreground="{StaticResource SecondaryText}" FontSize="10" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Bottom" Padding="15,8" CornerRadius="16"
                        Background="#75182029" BorderBrush="#58CA70FF" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="BALANCE" Foreground="#AEB9C5" FontSize="7.5" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="DailyPointsBalanceText" Text="— FP" Margin="10,0,0,0" Foreground="#F4E9FF" FontSize="13" FontWeight="Bold" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="0" MinHeight="540" ClipToBounds="True">
                <Grid>
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <RadialGradientBrush Center="0.22,0.12" GradientOrigin="0.22,0.12" RadiusX="0.82" RadiusY="0.96">
                        <GradientStop Color="#28B447FF" Offset="0" />
                        <GradientStop Color="#0D6D2B91" Offset="0.48" />
                        <GradientStop Color="#00101419" Offset="1" />
                      </RadialGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Grid Margin="24,22">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="142" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="132" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,9,0" VerticalAlignment="Center" />
                      <TextBlock Text="SEALED REWARD CACHE" Foreground="#D9C6E8" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="ONE UNLOCK PER DAY" Foreground="#8E7A9F" FontSize="7.5" FontWeight="Bold" />
                  </Grid>

                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid x:Name="DailyCaseVisual" RenderTransformOrigin="0.5,0.5">
                      <Grid.RenderTransform><TranslateTransform x:Name="DailyCaseTranslate" /></Grid.RenderTransform>
                      <Ellipse Width="210" Height="38" VerticalAlignment="Bottom" Fill="#52000000">
                        <Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect>
                      </Ellipse>
                      <Border Width="210" Height="118" CornerRadius="18" Background="#F01B1223"
                              BorderBrush="#8AD46CFF" BorderThickness="2" VerticalAlignment="Center">
                        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.58" Color="#B747FF" /></Border.Effect>
                        <Grid>
                          <Rectangle Margin="8" RadiusX="13" RadiusY="13">
                            <Rectangle.Fill>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#49334D63" Offset="0" />
                                <GradientStop Color="#251A172C" Offset="0.48" />
                                <GradientStop Color="#702E1749" Offset="1" />
                              </LinearGradientBrush>
                            </Rectangle.Fill>
                          </Rectangle>
                          <Path Data="M18,18 L192,18 M18,100 L192,100" Stroke="#32FFFFFF" StrokeThickness="1" />
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="assets/Aurora21-logo.png" Width="62" Height="62" Stretch="Uniform" />
                            <TextBlock Text="AURORA • DAILY" Margin="0,3,0,0" Foreground="#EEDCFA" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" />
                          </StackPanel>
                          <Border x:Name="DailyCaseLock" Width="30" Height="34" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,-13,0" Background="#FF9D4ED0" BorderBrush="#FFE4B6FF" BorderThickness="1">
                            <TextBlock Text="◆" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Grid>
                      </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="DAILY CACHE 01" Foreground="#F4E9FF" FontSize="20" FontWeight="SemiBold" />
                      <TextBlock Text="A sealed FIFA Points reward prepared by the Aurora vault. Unlock it to reveal today's item."
                                 Margin="0,8,0,0" MaxWidth="430" HorizontalAlignment="Left" TextWrapping="Wrap"
                                 Foreground="#9C8DAB" FontSize="9" LineHeight="15" />
                      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Padding="10,5" CornerRadius="12" Background="#4C2E1A3D" BorderBrush="#35CA70FF" BorderThickness="1">
                          <TextBlock Text="SERVER-SEALED" Foreground="#DAB8F1" FontSize="7" FontWeight="Bold" />
                        </Border>
                        <Border Margin="8,0,0,0" Padding="10,5" CornerRadius="12" Background="#391A252D" BorderBrush="#18FFFFFF" BorderThickness="1">
                          <TextBlock Text="DAILY" Foreground="#96A5B3" FontSize="7" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <Border x:Name="DailyDropReelViewport" Grid.Row="4" CornerRadius="15" Background="#F00B0D12"
                          BorderBrush="#4C9551B8" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                      <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E80A0C10" Offset="0" />
                            <GradientStop Color="#00281A35" Offset="0.18" />
                            <GradientStop Color="#00281A35" Offset="0.82" />
                            <GradientStop Color="#E80A0C10" Offset="1" />
                          </LinearGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                      <ScrollViewer x:Name="DailyDropReelScroller" Height="132"
                                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                    CanContentScroll="False" Focusable="False" IsHitTestVisible="False">
                        <StackPanel x:Name="DailyDropReelPanel" Height="132" Orientation="Horizontal" />
                      </ScrollViewer>
                      <Border x:Name="DailyDropSelectorBay" Width="54" HorizontalAlignment="Center" BorderBrush="#66E7B2FF" BorderThickness="1,0" Background="#0CCB6CFF" />
                      <Path Data="M0,0 L14,0 L7,9 Z" Fill="#FFE3B2FF" Width="14" Height="9" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Fill" />
                      <Path Data="M0,9 L14,9 L7,0 Z" Fill="#FFE3B2FF" Width="14" Height="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Stretch="Fill" />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,10">
                    <Border x:Name="DailyRewardResultBorder" Visibility="Collapsed" Margin="0,8,0,10" Padding="18,8" CornerRadius="14"
                            Background="#4A2C163A" BorderBrush="#8DC65CFF" BorderThickness="1">
                      <TextBlock x:Name="DailyRewardText" Text="You won 100 FP" Foreground="#F0D7FF" FontSize="15" FontWeight="Bold" />
                    </Border>
                    <Button x:Name="DailyDropClaimButton" Style="{StaticResource ActionButtonStyle}" Width="238" Height="52"
                            Content="UNLOCK DAILY CASE" FontSize="9" Click="DailyDropClaimButton_Click" />
                    <TextBlock x:Name="DailyDropCountdownText" Text="Checking availability…" Margin="0,10,0,0"
                               Foreground="#A993B9" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </StackPanel>

                  <TextBlock x:Name="DailyDropStatusText" Grid.Row="6" Text="Connect Discord to load your daily reward."
                             Foreground="{StaticResource SecondaryText}" FontSize="8.5" TextAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <!-- SETTINGS -->
          <ScrollViewer x:Name="SettingsView" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,4,8,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Keep the settings heading visually aligned with the Home page heading. -->
              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="CONFIGURATION" Foreground="#BFEAFF" FontSize="8" FontWeight="Bold" />
                  <TextBlock Text="Game installation" Margin="0,3,0,0" FontSize="25" FontWeight="Medium" />
                  <TextBlock Text="Choose the FIFA 21 executable used by Aurora 21." Margin="0,6,0,0"
                             Foreground="{StaticResource SecondaryText}" FontSize="10" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Bottom" Padding="11,6" CornerRadius="16"
                        Background="#75182029" BorderBrush="#18FFFFFF" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="LOCAL INSTALLATION" Foreground="#CCD7E2" FontSize="7" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Softer full-width glass settings surface. -->
              <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="0" ClipToBounds="True" MinHeight="386">
                <Grid>
                  <!-- Very subtle ambient tint so this page uses the same depth language as Home. -->
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <RadialGradientBrush Center="0.80,0.12" GradientOrigin="0.80,0.12" RadiusX="0.72" RadiusY="0.86">
                        <GradientStop Color="#158FC7E6" Offset="0" />
                        <GradientStop Color="#087A80C4" Offset="0.50" />
                        <GradientStop Color="#007A80C4" Offset="1" />
                      </RadialGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0BFFFFFF" Offset="0" />
                        <GradientStop Color="#02FFFFFF" Offset="0.48" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>

                  <Grid Margin="30,28">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.42*" />
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="0.58*" />
                    </Grid.ColumnDefinitions>

                    <!-- Installation controls -->
                    <StackPanel VerticalAlignment="Center">
                      <Border HorizontalAlignment="Left" Padding="11,6" CornerRadius="16"
                              Background="#6419232D" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="5" Height="5" Fill="#BFEAFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                          <TextBlock Text="GAME INSTALLATION" Foreground="#D7EAF3" FontSize="7" FontWeight="Bold" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="FIFA21.exe" Margin="0,18,0,0" FontSize="24" FontWeight="SemiBold" />
                      <TextBlock Text="Point Aurora 21 to the main FIFA 21 executable. This location is stored for your Windows user and can be changed at any time."
                                 Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                 Foreground="#AEB9C5" FontSize="10" LineHeight="16" TextWrapping="Wrap" />

                      <!-- Path field is grouped into its own quiet glass panel rather than floating loose on the card. -->
                      <Border Margin="0,24,0,0" Padding="17,15,17,17" CornerRadius="24"
                              Background="#55141B23" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <Border Width="28" Height="28" CornerRadius="12" Background="#641D2934" BorderBrush="#16FFFFFF" BorderThickness="1">
                                <TextBlock Text="⌁" Foreground="#CFEFFF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GAME EXECUTABLE" Foreground="#C4CFDA" FontSize="7" FontWeight="Bold" />
                                <TextBlock Text="Windows path" Margin="0,2,0,0" Foreground="#788695" FontSize="7.5" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="FIFA 21" Foreground="#748291" FontSize="7.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </Grid>

                          <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="10" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GamePathTextBox" Style="{StaticResource SettingsTextBoxStyle}" />
                            <Button Grid.Column="2" Style="{StaticResource SettingsButtonStyle}" Width="116"
                                    Content="BROWSE…" Click="BrowseGameButton_Click" ToolTip="Choose FIFA21.exe" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Margin="0,15,0,0" Padding="17,14" CornerRadius="22"
                              Background="#55141B23" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="SOUND EFFECTS" Foreground="#DCE8F2" FontSize="9" FontWeight="Bold" />
                            <TextBlock Text="Control interface, Daily Drop, startup, exit, and warning sounds independently from music."
                                       Margin="0,5,0,0" Foreground="#8493A2" FontSize="8.5"
                                       TextWrapping="Wrap" MaxWidth="350" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SoundEffectsVolumeSlider"
                                    Style="{StaticResource MusicSliderStyle}"
                                    Width="150" Minimum="0" Maximum="1" Value="0.20"
                                    SmallChange="0.05" LargeChange="0.10"
                                    ValueChanged="SoundEffectsVolumeSlider_ValueChanged"
                                    ToolTip="Sound-effects volume" />
                            <CheckBox x:Name="SoundEffectsMuteCheckBox"
                                      Margin="16,0,0,0" Content="Mute effects"
                                      Foreground="#C4CFDA" FontSize="8.5"
                                      Checked="SoundEffectsMuteCheckBox_Changed"
                                      Unchecked="SoundEffectsMuteCheckBox_Changed"
                                      ToolTip="Mute interface sounds without muting music" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Border Margin="0,15,0,0" Padding="17,14" CornerRadius="22"
                              Background="#55141B23" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="EA ACTIVATION" Foreground="#DCE8F2" FontSize="9" FontWeight="Bold" />
                            <TextBlock Text="Launch through EA App activation instead of starting FIFA21.exe directly."
                                       Margin="0,5,0,0" Foreground="#8493A2" FontSize="8.5"
                                       TextWrapping="Wrap" MaxWidth="470" />
                          </StackPanel>
                          <CheckBox x:Name="EaActivationCheckBox" Grid.Column="1"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    ToolTip="Use the legacy EA App origin2 activation launch" />
                        </Grid>
                      </Border>

                      <Border Margin="0,15,0,0" Padding="17,14" CornerRadius="22"
                              Background="#55141B23" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="WINDOW BEHAVIOUR" Foreground="#DCE8F2" FontSize="9" FontWeight="Bold" />
                            <TextBlock Text="Keep the launcher above other windows. Clear this option to use normal window stacking."
                                       Margin="0,5,0,0" Foreground="#8493A2" FontSize="8.5"
                                       TextWrapping="Wrap" MaxWidth="470" />
                          </StackPanel>
                          <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Column="1"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    ToolTip="Keep Aurora 21 above other windows" />
                        </Grid>
                      </Border>

                      <Border Margin="0,15,0,0" Padding="17,14" CornerRadius="22"
                              Background="#55141B23" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="SHORTCUTS" Foreground="#DCE8F2" FontSize="9" FontWeight="Bold" />
                            <TextBlock Text="Add another Aurora 21 shortcut whenever you need one."
                                       Margin="0,5,0,0" Foreground="#8493A2" FontSize="8.5"
                                       TextWrapping="Wrap" MaxWidth="360" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SettingsButtonStyle}" Width="116"
                                    Content="DESKTOP" Click="CreateDesktopShortcutButton_Click"
                                    ToolTip="Add Aurora 21 to the desktop" />
                            <Button Style="{StaticResource SettingsButtonStyle}" Width="116" Margin="10,0,0,0"
                                    Content="START MENU" Click="CreateStartMenuShortcutButton_Click"
                                    ToolTip="Add Aurora 21 to the Start Menu" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <!-- Save/status footer -->
                      <Border Margin="0,15,0,0" Padding="17,13" CornerRadius="22"
                              Background="#3F141B23" BorderBrush="#12FFFFFF" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SettingsStatusText"
                                       Text="The game location is saved for this Windows user."
                                       Foreground="#9EABB8" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Width="146" Height="46"
                                  Margin="16,0,0,0" Content="SAVE CHANGES" FontSize="8.5" Click="SaveSettingsButton_Click" />
                        </Grid>
                      </Border>
                    </StackPanel>

                    <!-- FIFA artwork card: softened and layered to match the Home glass treatment. -->
                    <Border Grid.Column="2" CornerRadius="28" Background="#4E121820" BorderBrush="#16FFFFFF" BorderThickness="1" ClipToBounds="True">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.13" Color="#000000" />
                      </Border.Effect>
                      <Grid>
                        <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill" Opacity="0.86" />
                        <Rectangle Fill="#4A091018" />
                        <Rectangle>
                          <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Color="#05FFFFFF" Offset="0" />
                              <GradientStop Color="#16081016" Offset="0.46" />
                              <GradientStop Color="#D4080D13" Offset="1" />
                            </LinearGradientBrush>
                          </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                          <Rectangle.Fill>
                            <RadialGradientBrush Center="0.75,0.14" GradientOrigin="0.75,0.14" RadiusX="0.78" RadiusY="0.72">
                              <GradientStop Color="#22A9DFF2" Offset="0" />
                              <GradientStop Color="#00A9DFF2" Offset="1" />
                            </RadialGradientBrush>
                          </Rectangle.Fill>
                        </Rectangle>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Width="42" Height="42"
                                CornerRadius="15" Background="#9A151D26" BorderBrush="#58CA70FF" BorderThickness="1">
                          <Image Source="assets/Aurora21-logo.png" Margin="3" Stretch="Uniform" />
                        </Border>

                        <StackPanel Margin="20" VerticalAlignment="Bottom">
                          <Border HorizontalAlignment="Left" Padding="9,5" CornerRadius="13"
                                  Background="#8C171F28" BorderBrush="#16FFFFFF" BorderThickness="1">
                            <TextBlock Text="AURORA 21 • ALPHA V1" Foreground="#E7F4FA" FontSize="7" FontWeight="Bold" />
                          </Border>
                          <TextBlock Text="FIFA 21 REVIVAL" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="Private Ultimate Team revival network" Margin="0,5,0,0"
                                     Foreground="#92A0AE" FontSize="8" LineHeight="13" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <!-- CONNECTION / LIVE DIAGNOSTICS -->
          <ScrollViewer x:Name="ConnectionView" Grid.Column="2" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="8,4,8,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="CONNECTION" Foreground="#BFEAFF" FontSize="8" FontWeight="Bold" />
                  <TextBlock Text="Live diagnostics" Margin="0,3,0,0" FontSize="25" FontWeight="Medium" />
                  <TextBlock Text="A simplified timeline of what Aurora 21 is starting, checking and waiting for."
                             Margin="0,6,0,0" Foreground="{StaticResource SecondaryText}" FontSize="10" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Bottom" Padding="11,6" CornerRadius="16"
                        Background="#75182029" BorderBrush="#18FFFFFF" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConnectionLogCountText" Text="LIVE • 0 EVENTS" Foreground="#CCD7E2"
                               FontSize="7" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="22" MinHeight="520" ClipToBounds="True">
                <Grid>
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <RadialGradientBrush Center="0.82,0.10" GradientOrigin="0.82,0.10" RadiusX="0.72" RadiusY="0.86">
                        <GradientStop Color="#148FC7E6" Offset="0" />
                        <GradientStop Color="#087A80C4" Offset="0.50" />
                        <GradientStop Color="#007A80C4" Offset="1" />
                      </RadialGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>

                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="16" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="16" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Launch &amp; connection timeline" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Normal events stay concise. Failures expand with the exact step, exit code and diagnostic output Aurora 21 received."
                                   Margin="0,5,0,0" Foreground="#96A4B2" FontSize="9" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" Padding="10,6" CornerRadius="15" Background="#53141B23"
                              BorderBrush="#14FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                          <TextBlock Text="SESSION LOG" Foreground="#CBD7E1" FontSize="7" FontWeight="Bold" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Padding="15,13" CornerRadius="20" Background="#49141B23" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="SECURE ROUTE" Foreground="#9DABB8" FontSize="7" FontWeight="Bold" />
                          </StackPanel>
                          <TextBlock x:Name="ConnectionPageNetworkText" Text="Checking…" Margin="0,7,0,0"
                                     FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" Padding="15,13" CornerRadius="20" Background="#49141B23" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#BFEAFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="PREREQUISITES" Foreground="#9DABB8" FontSize="7" FontWeight="Bold" />
                          </StackPanel>
                          <TextBlock x:Name="ConnectionPagePythonText" Text="Checking Python…" Margin="0,7,0,0"
                                     FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="4" Padding="15,13" CornerRadius="20" Background="#49141B23" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource MutedDotBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="FIFA 21" Foreground="#9DABB8" FontSize="7" FontWeight="Bold" />
                          </StackPanel>
                          <TextBlock x:Name="ConnectionPageGameText" Text="Not running" Margin="0,7,0,0"
                                     FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Border Grid.Row="4" CornerRadius="24" Background="#6610161D" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="0" ClipToBounds="True">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="18,15,18,12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal">
                            <Viewbox Width="17" Height="15" Margin="0,0,9,0">
                              <Canvas Width="20" Height="18">
                                <Path Data="M2.5,2.5 L17.5,2.5 L17.5,12.5 L2.5,12.5 Z"
                                      Stroke="#CFEFFF" StrokeThickness="1.4" StrokeLineJoin="Round" />
                                <Path Data="M7,16 L13,16 M10,12.5 L10,16"
                                      Stroke="#CFEFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                              </Canvas>
                            </Viewbox>
                            <TextBlock Text="ACTIVITY" Foreground="#C4D0DA" FontSize="7.5" FontWeight="Bold" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="Newest events appear at the bottom" Foreground="#6F7D8A" FontSize="7.5" VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer x:Name="ConnectionLogScrollViewer" Grid.Row="1" Height="310"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,0,14,0">
                          <StackPanel>
                            <TextBlock x:Name="ConnectionLogEmptyState"
                                       Text="Waiting for launcher activity…"
                                       Foreground="#6F7D8A" FontSize="9" Margin="5,8,5,10" />
                            <StackPanel x:Name="ConnectionLogPanel" />
                          </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#38141B23" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Padding="18,10">
                          <TextBlock Text="Detailed failures include the observed exception or exit code plus recent script/runtime output where available."
                                     Foreground="#748290" FontSize="7.8" TextWrapping="Wrap" />
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Vector particle layer used for restrained button hover shimmer. -->
      <Canvas x:Name="ButtonParticleLayer" Panel.ZIndex="80" IsHitTestVisible="False" ClipToBounds="True" />

      <!-- Startup welcome screen -->
      <Grid x:Name="WelcomeOverlay" Panel.ZIndex="100" Background="#F0070A0F" Opacity="1">
        <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill" Opacity="0.28">
          <Image.Effect><BlurEffect Radius="32" /></Image.Effect>
          <Image.RenderTransform><ScaleTransform ScaleX="1.12" ScaleY="1.12" /></Image.RenderTransform>
        </Image>
        <Rectangle Fill="#B6070A0F" />
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,0.44" GradientOrigin="0.5,0.44" RadiusX="0.5" RadiusY="0.6">
              <GradientStop Color="#55BD43FF" Offset="0" />
              <GradientStop Color="#20FF47D7" Offset="0.48" />
              <GradientStop Color="#00A83CFF" Offset="1" />
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="WelcomeContent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <StackPanel.RenderTransform><ScaleTransform x:Name="WelcomeScale" ScaleX="0.93" ScaleY="0.93" /></StackPanel.RenderTransform>
          <Border Width="92" Height="92" CornerRadius="30" Background="#B5181021" BorderBrush="#82D979FF" BorderThickness="1" HorizontalAlignment="Center" ClipToBounds="True">
            <Border.Effect><DropShadowEffect BlurRadius="46" ShadowDepth="0" Opacity="0.60" Color="#C247FF" /></Border.Effect>
            <Grid>
              <Border Margin="1" CornerRadius="29" Background="{StaticResource GlassSheenBrush}" Opacity="0.52" />
              <Image Source="pack://application:,,,/assets/Aurora21-logo.png" Margin="4" Stretch="Uniform" />
            </Grid>
          </Border>
          <TextBlock Text="Welcome" Margin="0,22,0,0" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="AURORA 21 • ALPHA V1" Margin="0,7,0,0" Foreground="#B9C9D8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
          <Border Margin="0,20,0,0" Padding="12,7" CornerRadius="17" Background="#B8171E26" BorderBrush="#2CFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Preparing your launcher" Foreground="#DDE8F2" FontSize="8.5" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- First-launch-only shortcut choice. State is stored under the current
           Windows user's LocalAppData so this does not reappear after updates. -->
      <Grid x:Name="FirstRunShortcutOverlay" Panel.ZIndex="105" Background="#F0070A0F" Opacity="0" Visibility="Collapsed">
        <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill" Opacity="0.20">
          <Image.Effect><BlurEffect Radius="36" /></Image.Effect>
          <Image.RenderTransform><ScaleTransform ScaleX="1.14" ScaleY="1.14" /></Image.RenderTransform>
        </Image>
        <Rectangle Fill="#C5070A0F" />
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,0.43" GradientOrigin="0.5,0.43" RadiusX="0.52" RadiusY="0.62">
              <GradientStop Color="#48BD43FF" Offset="0" />
              <GradientStop Color="#18FF47D7" Offset="0.52" />
              <GradientStop Color="#00A83CFF" Offset="1" />
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <Border Width="610" MaxWidth="760" Padding="34,32,34,30" CornerRadius="30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E1121820" BorderBrush="#24FFFFFF" BorderThickness="1">
          <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.25" Color="#02060A" /></Border.Effect>
          <Grid>
            <Border Margin="1" CornerRadius="29" Background="{StaticResource GlassSheenBrush}" Opacity="0.22" IsHitTestVisible="False" />
            <StackPanel x:Name="FirstRunShortcutContent" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform><ScaleTransform x:Name="FirstRunShortcutScale" ScaleX="0.95" ScaleY="0.95" /></StackPanel.RenderTransform>

              <Border Width="82" Height="82" CornerRadius="27" Background="#A8181021" BorderBrush="#72D277FF" BorderThickness="1" HorizontalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.52" Color="#C247FF" /></Border.Effect>
                <Grid>
                  <Border Margin="1" CornerRadius="26" Background="{StaticResource GlassSheenBrush}" Opacity="0.40" />
                  <Image Source="pack://application:,,,/assets/Aurora21-logo.png" Margin="4" Stretch="Uniform" />
                </Grid>
              </Border>

              <TextBlock Text="Quick access" Margin="0,20,0,0" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Would you like Aurora 21 added to Windows shortcuts?"
                         Margin="0,8,0,0" Foreground="#AEBBC7" FontSize="10.5" TextAlignment="Center" HorizontalAlignment="Center" />
              <TextBlock Text="You can choose Desktop + Start Menu, Start Menu only, or skip this."
                         Margin="0,5,0,0" Foreground="#748290" FontSize="8.5" TextAlignment="Center" HorizontalAlignment="Center" />

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                <Button x:Name="FirstRunDesktopAndStartButton" Style="{StaticResource ActionButtonStyle}" Width="182" Height="45"
                        Content="DESKTOP + START MENU" FontSize="8.2" Click="FirstRunDesktopAndStartButton_Click" />
                <Button x:Name="FirstRunStartMenuOnlyButton" Style="{StaticResource SecondaryActionButtonStyle}" Width="146" Height="45" Margin="10,0,0,0"
                        Content="START MENU ONLY" FontSize="8.2" Click="FirstRunStartMenuOnlyButton_Click" />
                <Button x:Name="FirstRunNoButton" Style="{StaticResource SecondaryActionButtonStyle}" Width="94" Height="45" Margin="10,0,0,0"
                        Content="NO" FontSize="8.2" Click="FirstRunNoButton_Click" />
              </StackPanel>

              <TextBlock x:Name="FirstRunShortcutStatusText" Text="Choose where you want quick access to Aurora 21."
                         Margin="0,18,0,0" Foreground="#A8B5C2" FontSize="8.2" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Successful FIFA launch screen. This is shown only after a new FIFA21.exe
           process has a real main window, then the launcher fades itself closed. -->
      <Grid x:Name="GameLaunchedOverlay" Panel.ZIndex="110" Background="#F0070A0F" Opacity="0" Visibility="Collapsed">
        <Image Source="pack://application:,,,/launcherimage.webp" Stretch="UniformToFill" Opacity="0.24">
          <Image.Effect><BlurEffect Radius="34" /></Image.Effect>
          <Image.RenderTransform><ScaleTransform ScaleX="1.13" ScaleY="1.13" /></Image.RenderTransform>
        </Image>
        <Rectangle Fill="#BC070A0F" />
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,0.44" GradientOrigin="0.5,0.44" RadiusX="0.5" RadiusY="0.6">
              <GradientStop Color="#55BD43FF" Offset="0" />
              <GradientStop Color="#20FF47D7" Offset="0.48" />
              <GradientStop Color="#00A83CFF" Offset="1" />
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="GameLaunchedContent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <StackPanel.RenderTransform><ScaleTransform x:Name="GameLaunchedScale" ScaleX="0.94" ScaleY="0.94" /></StackPanel.RenderTransform>
          <Border Width="92" Height="92" CornerRadius="30" Background="#B5181021" BorderBrush="#82D979FF" BorderThickness="1" HorizontalAlignment="Center" ClipToBounds="True">
            <Border.Effect><DropShadowEffect BlurRadius="46" ShadowDepth="0" Opacity="0.60" Color="#C247FF" /></Border.Effect>
            <Grid>
              <Border Margin="1" CornerRadius="29" Background="{StaticResource GlassSheenBrush}" Opacity="0.52" />
              <Image Source="pack://application:,,,/assets/Aurora21-logo.png" Margin="4" Stretch="Uniform" />
            </Grid>
          </Border>
          <TextBlock x:Name="GameLaunchedTitleText" Text="Game launched, have fun" Margin="0,22,0,0" FontSize="31" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="AURORA 21 • ALPHA V1" Margin="0,7,0,0" Foreground="#B9C9D8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
          <Border Margin="0,20,0,0" Padding="12,7" CornerRadius="17" Background="#B8171E26" BorderBrush="#2CFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock x:Name="GameLaunchedStatusText" Text="FIFA 21 is ready" Foreground="#DDE8F2" FontSize="8.5" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Grid x:Name="StartupMediaOverlay" Panel.ZIndex="200" Background="#FF070A0F">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
          <Border Width="96" Height="96" CornerRadius="31" Background="#B5181021" BorderBrush="#82D979FF" BorderThickness="1" HorizontalAlignment="Center">
            <Border.Effect><DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.62" Color="#C247FF" /></Border.Effect>
            <Image Source="pack://application:,,,/assets/Aurora21-logo.png" Margin="4" Stretch="Uniform" />
          </Border>
          <TextBlock Text="PREPARING AURORA 21 • ALPHA V1" Margin="0,24,0,0" HorizontalAlignment="Center" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="Downloading and verifying launcher media…" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="#A8B5C2" FontSize="10" />
          <ProgressBar Height="4" Margin="42,24,42,0" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#252A32" BorderThickness="0" />
          <TextBlock Text="The full launcher will open automatically when it is ready." Margin="0,17,0,0" HorizontalAlignment="Center" Foreground="#687582" FontSize="8.5" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
