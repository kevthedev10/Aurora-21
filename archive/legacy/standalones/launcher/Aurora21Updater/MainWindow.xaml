<Window x:Class="Aurora21Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora 21 Updater" Width="760" Height="475"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border CornerRadius="30" BorderBrush="#36FFFFFF" BorderThickness="1" Background="#F20B0D14">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="10" Opacity="0.52" />
    </Border.Effect>
    <Grid ClipToBounds="True">
      <Grid.Clip>
        <RectangleGeometry Rect="0,0,760,475" RadiusX="30" RadiusY="30" />
      </Grid.Clip>

      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.83,0.05" GradientOrigin="0.83,0.05" RadiusX="0.72" RadiusY="0.82">
            <GradientStop Color="#5E9C43D0" Offset="0" />
            <GradientStop Color="#232D153F" Offset="0.46" />
            <GradientStop Color="#000B0D14" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-210,0,0,-245" Fill="#302C69D7">
        <Ellipse.Effect><BlurEffect Radius="80" /></Ellipse.Effect>
      </Ellipse>

      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="15" Background="#671E172A" BorderBrush="#63D47BFF" BorderThickness="1">
              <Image Source="assets/Aurora21-logo.png" Margin="4" Stretch="Uniform" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="AURORA 21" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="STANDALONE UPDATER  •  ALPHA V1" Foreground="#9E91AA" FontSize="8" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource WindowButton}" Content="—" Click="MinimizeButton_Click" />
            <Button Style="{StaticResource WindowButton}" Content="×" FontSize="19" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" CornerRadius="25" Background="#B3141720" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="34,30,34,27">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="0" Opacity="0.24" /></Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StageDot" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0">
                <Ellipse.Effect><DropShadowEffect Color="#D56FFF" BlurRadius="12" ShadowDepth="0" Opacity="0.9" /></Ellipse.Effect>
              </Ellipse>
              <TextBlock x:Name="EyebrowText" Text="SECURE RELEASE CHANNEL" Foreground="#D38EF4" FontSize="9" FontWeight="Bold" />
            </StackPanel>

            <TextBlock x:Name="HeadingText" Grid.Row="1" Text="Preparing the latest launcher" Foreground="{StaticResource TextPrimary}"
                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Connecting securely to the Aurora release server..." Foreground="{StaticResource TextMuted}"
                       FontSize="12" LineHeight="20" TextWrapping="Wrap" MaxHeight="66" Margin="0,10,0,0" />

            <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,20,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Background="#571C1524" BorderBrush="#25DC8EFF" BorderThickness="1" CornerRadius="12" Padding="13,9">
                <TextBlock Text="Note: This may take a while, whilst you wait go tell tormusi i said hi"
                           Foreground="#D8B5E8" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" />
              </Border>
              <Grid Grid.Row="1" Margin="0,18,0,0">
                <Border x:Name="ProgressTrack" Height="12" CornerRadius="6" Background="#4A272334" BorderBrush="#34FFFFFF" BorderThickness="1" ClipToBounds="True">
                  <Canvas x:Name="ProgressCanvas" ClipToBounds="True">
                    <Border x:Name="ProgressFill" Height="10" Width="0" CornerRadius="5" Canvas.Left="0" Canvas.Top="0">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#7D43E8" Offset="0" />
                          <GradientStop Color="#C85BFA" Offset="0.58" />
                          <GradientStop Color="#ED9CFF" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.Effect><DropShadowEffect Color="#C95DFF" BlurRadius="11" ShadowDepth="0" Opacity="0.72" /></Border.Effect>
                    </Border>
                  </Canvas>
                </Border>
              </Grid>
            </Grid>

            <Grid Grid.Row="4" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="224" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="PercentText" Text="CONNECTING" Foreground="#8F8599" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
              <!-- Keep the button and its glow inside a dedicated padded viewport. -->
              <Border Grid.Column="1" Width="224" Height="62" Background="Transparent" CornerRadius="28" ClipToBounds="True">
                <Button x:Name="ActionButton" Content="PLEASE WAIT" Style="{StaticResource PrimaryButton}"
                        Width="196" Margin="14,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsEnabled="False" Click="ActionButton_Click" />
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
