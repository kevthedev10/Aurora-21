      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, endpoint) (rate(ultimateteam_api_endpoint_milliseconds_bucket[5m]))))",
          "legendFormat": "{{endpoint}}"
