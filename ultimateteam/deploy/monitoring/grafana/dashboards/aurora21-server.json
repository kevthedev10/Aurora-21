      "description": "Top 8 endpoints by 95th percentile duration. Endpoint names are route groups; no ids or query strings."
    },
    {
      "type": "table",
      "title": "Where request time goes",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (endpoint) (rate(ultimateteam_api_endpoint_milliseconds_sum[15m])))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "ms per second",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "ms per second",
              "endpoint": "Endpoint"
            }
          }
        }
      ],
      "description": "Total time spent per endpoint over 15 minutes: rate times duration. The top rows are where optimisation pays."
    },
