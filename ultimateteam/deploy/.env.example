# Copy to .env beside compose.yaml on the VPS (.env is git-ignored; keep it mode 600). Never commit real values.

# --- Required -------------------------------------------------------------------------------------------------------

# The PostgreSQL password for the private database (a long random value, e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=

# The VPS's public IPv4 address: the gameplay relay advertises it, and the launcher points FIFA's hosts entry at it.
PUBLIC_IPV4=

# Hosted TCP idle probes are enabled on deployment without rewriting config.json.
# Set 0 to disable; interval/retries still come from config.json or bundled defaults.
TCP_KEEPALIVE_IDLE_SECONDS=30

# --- Public launcher API and optional launch identity ---------------------------------------------------------------

# The public HTTPS name of this server's launcher API (DNS A record -> PUBLIC_IPV4; ports 80 and 443 open). Setting it
# starts the caddy service, which gets a Let's Encrypt certificate and forwards /client/* and /api/v1/launch/* only.
LAUNCHER_DOMAIN=

# The account service's launch assertions: its exact issuer ("iss"), and EITHER its ES256 public key (preferred: the
# SPKI PEM's base64 body on one line, or the PEM with \n for line breaks) OR an HS256 secret shared only with this
# server (at least 32 characters; never the secret any other game uses). These may stay empty while bringing only the
# server and API online: /client/health responds, but launch requests cannot issue a game code.
LAUNCH_ISSUER=
LAUNCH_ES256_PUBLIC_KEY=
LAUNCH_HS256_SECRET=

# The Discord bot that checks roles in the Aurora Discord server (the same bot Aurora 13/16 use; it must be a member of
# the server). Who may play and who bypasses maintenance are set by role in the operator panel (Maintenance tab).
# This may stay empty until role checks are configured; do not set play roles before the bot is ready.
DISCORD_BOT_TOKEN=

# --- Set by the Deploy workflow ---------------------------------------------------------------------------------------

# The server image it deployed (for example ghcr.io/<owner>/aurora21-ultimateteam-server and sha-1a2b3c4); leave both
# unset to use an image built on the VPS (aurora21/ultimateteam-server:local).
IMAGE=
IMAGE_TAG=

# Numeric primary group of the deploy user, recorded by restart-worker.sh install / remote-deploy.sh.
# Required for the unprivileged app container to read the worker heartbeat and queue a restart.
RESTART_WORKER_GID=

# "launcher" while LAUNCHER_DOMAIN is set and "monitoring" while GRAFANA_ADMIN_PASSWORD is set (remote-deploy.sh keeps
# this in step); they start the caddy service and the monitoring stack.
COMPOSE_PROFILES=

# --- Capacity (defaults sized for 12 vCPU / 24 GB / NVMe) --------------------------------------------------------------

# The most players online at once: each connected player's club stays open (see README.md, Capacity). Keep it above the
# panel's player cap, so the cap (not "player capacity reached") is what turns players away.
PLAYER_MAX_OPEN_CLUBS=1000
# The gameplay relay's UDP port range: one pair per match being played, so 1000 ports is 500 matches at once. The
# firewall must allow the whole range.
RELAY_PORT_START=31000
RELAY_PORT_END=31999
# PostgreSQL memory and connections. Keep the server's database.max_pool_size (config.json in the state volume) below
# PG_MAX_CONNECTIONS minus its connection_reserve. Changing these restarts PostgreSQL on the next deploy.
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=6GB
PG_EFFECTIVE_CACHE_SIZE=16GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=1GB

# --- Monitoring (optional) ------------------------------------------------------------------------------------------

# Setting GRAFANA_ADMIN_PASSWORD turns on Prometheus, node-exporter, postgres-exporter and Grafana, all on the VPS's
# loopback only (Grafana 127.0.0.1:3000 through an SSH tunnel), and the server's metric export. The password applies when
# Grafana's volume is first created. MONITOR_DB_PASSWORD is the read-only aurora_monitor database role's password
# (pg_monitor statistics only). Use long random values, e.g. openssl rand -hex 32.
GRAFANA_ADMIN_PASSWORD=
MONITOR_DB_PASSWORD=
# How long Prometheus keeps data, by age and by size (whichever is reached first).
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB

# --- Optional ---------------------------------------------------------------------------------------------------------

# Daily database backups: the folder on the VPS (relative to this file or absolute), the UTC hour to run, and how many
# daily dumps to keep (7 = one week).
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAILY=7

# The operator panel's images (card frames, players, badges, flags), copied here from download-card-images.py on your PC:
#   rsync -a <runtime>/panel-assets/ deploy@<vps>:/opt/aurora21/panel-assets/
# Mounted read-only into the server; the panel shows text instead of art while it is empty.
PANEL_ASSETS_DIR=./panel-assets
