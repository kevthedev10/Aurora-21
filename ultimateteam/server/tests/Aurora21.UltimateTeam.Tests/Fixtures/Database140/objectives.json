    "rewardPackId": 513,
    "rewardPackCount": 3,
    "rewardUntradeable": true,
    "xpAward": 1500, "stat": "matches", "target": 1
  },

  "_xpComment": "Season Progress XP per event: every counted match, plus win on a win, each first SBC completion and each opened pack except an SBC reward pack. Matches ending with noProgressEndReasons count nothing.",
